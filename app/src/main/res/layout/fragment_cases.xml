<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#1a1a2e">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Открыть кейс"
        android:textColor="#e94560"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <!-- Кнопка для кейса Силы -->
    <Button
        android:id="@+id/btnStrength"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="💪 Кейс Силы"
        android:textSize="18sp"
        android:backgroundTint="#c62828"
        android:layout_marginBottom="16dp" />

    <!-- Кнопка для кейса Ловкости -->
    <Button
        android:id="@+id/btnAgility"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🗡️ Кейс Ловкости"
        android:textSize="18sp"
        android:backgroundTint="#2e7d32"
        android:layout_marginBottom="16dp" />

    <!-- Кнопка для кейса Интеллекта -->
    <Button
        android:id="@+id/btnIntelligence"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🧠 Кейс Интеллекта"
        android:textSize="18sp"
        android:backgroundTint="#1565c0"
        android:layout_marginBottom="16dp" />

    <!-- Кнопка для кейса Универсалов -->
    <Button
        android:id="@+id/btnUniversal"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="⚡ Кейс Универсалов"
        android:textSize="18sp"
        android:backgroundTint="#6a1b9a" />

</LinearLayout>
