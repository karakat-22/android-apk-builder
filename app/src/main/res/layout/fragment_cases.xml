<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ВЫБЕРИТЕ КЕЙС"
        android:textSize="28sp"
        style="@style/DotaTextStyle"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnStrength"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="💪 СИЛА"
        android:textSize="20sp"
        android:textColor="#D4AF37"
        android:background="@drawable/btn_dota"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnAgility"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🗡️ ЛОВКОСТЬ"
        android:textSize="20sp"
        android:textColor="#D4AF37"
        android:background="@drawable/btn_dota"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnIntelligence"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🧠 ИНТЕЛЛЕКТ"
        android:textSize="20sp"
        android:textColor="#D4AF37"
        android:background="@drawable/btn_dota"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnUniversal"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="⚡ УНИВЕРСАЛЫ"
        android:textSize="20sp"
        android:textColor="#D4AF37"
        android:background="@drawable/btn_dota" />
</LinearLayout>
